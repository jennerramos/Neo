# Neo v2 — VPS deployment env. Copy to deploy/.env.deploy and fill in.
#
#     cp deploy/.env.deploy.example deploy/.env.deploy
#     docker compose --env-file deploy/.env.deploy up -d --build
#
# This is NOT the workstation .env. That one carries the pipeline's world —
# WhisperX, CUDA, YouTube keys, proxy credentials, PIPELINE_LLM_* — none of
# which the serving stack imports. Keep them separate; the pipeline stays on
# the workstation (P1-5).
#
# deploy/.env.deploy is gitignored. Treat it as a secret file: chmod 600.

# ── Domain + TLS ─────────────────────────────────────────────────────────────
NEO_DOMAIN=neo.example.com
NEO_ACME_EMAIL=you@example.com

# ── Basic auth (P0-2) ────────────────────────────────────────────────────────
# Generate the hash — note the single quotes, the bcrypt output is full of $:
#     docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
NEO_BASIC_AUTH_USER=pilot
NEO_BASIC_AUTH_HASH='$2a$14$replace-with-real-bcrypt-hash'

# ── Postgres ─────────────────────────────────────────────────────────────────
# docker-compose.yml builds DATABASE_URL from these; do not set DATABASE_URL
# here, it would be overridden anyway.
POSTGRES_DB=neo_v2
POSTGRES_USER=neo
POSTGRES_PASSWORD=
# Match your workstation's major version before the first pg_dump restore.
POSTGRES_IMAGE_TAG=16-alpine

# ── Qdrant ───────────────────────────────────────────────────────────────────
# Pin this. `latest` is a moving target: the image bundled qdrant-client (1.19)
# warns loudly against a 1.17 server, and a newer server may upgrade the
# on-disk format of a restored snapshot irreversibly. Set it to the version
# your workstation runs.
QDRANT_IMAGE_TAG=latest
QDRANT_COLLECTION=neo_v2_chunks

# ── Serving LLM ──────────────────────────────────────────────────────────────
# This is what makes a 4 GB VPS viable: generation is an outbound HTTPS call,
# not a resident model. Leaving LLM_PROVIDER=ollama here would point the API at
# a localhost Ollama that does not exist on this box, and every /ask would fail.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# Reasoning models spend thinking tokens out of this budget before the first
# visible token — see the note in .env.example.
LLM_MAX_TOKENS=8192
LLM_REASONING_EFFORT=none

# ── Retrieval ────────────────────────────────────────────────────────────────
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8

# Set these to the box's vCPU count. Torch reads the HOST cpu count, not the
# container's CPU limit, so on a 2-vCPU VPS it happily starts 12 threads and
# thrashes. Measured on a simulated CX22: 45 s -> 29 s for one retrieve+rerank
# just from matching the thread count. See the benchmark table in README.md —
# CPU reranking is the single biggest latency item on a small VPS.
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
# Must match what was baked into the image (Dockerfile ARGs of the same names).
# Changing these here alone means a download on every container start.
#
# onnx is ~19x faster end-to-end on a small VPS (29.0s -> 1.5s per retrieve)
# and halves the image. It is a different model, not just a different runtime —
# see the benchmark and the caveats in README.md before switching.
#   RERANKER_BACKEND=onnx
#   RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_BACKEND=torch
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Thread cap for the ONNX runtime; leave unset on torch. Same reasoning as
# OMP_NUM_THREADS above — fastembed reads the host core count otherwise.
# RERANKER_THREADS=2

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000
# Only needed if a browser calls the API on a hostname other than NEO_DOMAIN.
# Normal traffic is same-origin through Caddy, so this can stay unset.
# NEO_CORS_ORIGINS=https://neo.example.com

# ── Observability ────────────────────────────────────────────────────────────
NEO_QUERY_LOG=on
