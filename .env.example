# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/neo_v2
SQL_ECHO=false

# ── YouTube / Google ──────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Browser for yt-dlp cookie extraction (firefox | chrome | edge | leave blank to disable)
YT_DLP_COOKIES_BROWSER=firefox

# Webshare residential rotating proxy URL (HTTP).
# Username can include or omit a numeric suffix (`-1`, `-2`...); the captioner
# strips it and adds `-rotate` so each request lands on a fresh residential IP.
# Leave blank to fetch captions direct from your local IP.
PROXY_LIST=http://username:password@p.webshare.io:80/

# ── WhisperX / ASR ───────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3
DEVICE=cuda
COMPUTE_TYPE=float16
HUGGINGFACE_TOKEN=your_hf_token_here   # required for pyannote diarization

# ── Ollama (local LLM for extraction) ────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Claude API (customer-facing RAG) ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-6

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=neo_v2_chunks

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8

# ── Quality Gate ─────────────────────────────────────────────────────────────
MIN_WORD_COUNT=500
MIN_QUALITY_SCORE=0.6

# ── API / UI ports ────────────────────────────────────────────────────────────
API_PORT=8000
UI_PORT=8501

# ── Observability ─────────────────────────────────────────────────────────────
# Set to "off" to disable per-query JSONL log writes in observability/query_log.py
NEO_QUERY_LOG=on
# Optional override for where the log file lives (defaults to data/query_log.jsonl)
# NEO_QUERY_LOG_PATH=

PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# ── Next.js dev server (frontend/) ────────────────────────────────────────────
# The Next.js rewrite in next.config.mjs proxies /api/* to this host. Set this
# only on the SERVER side (don't expose as NEXT_PUBLIC_*). Defaults to localhost.
NEO_API_TARGET=http://localhost:8000
