# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/neo_v2
SQL_ECHO=false

# ── YouTube / Google ──────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Browser for yt-dlp cookie extraction (firefox | chrome | edge | leave blank to disable)
YT_DLP_COOKIES_BROWSER=firefox

# Webshare residential rotating proxy URL (HTTP).
# Username can include or omit a numeric suffix (`-1`, `-2`...); the captioner
# strips it and adds `-rotate` so each request lands on a fresh residential IP.
# Leave blank to fetch captions direct from your local IP.
PROXY_LIST=http://username:password@p.webshare.io:80/

# ── WhisperX / ASR ───────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3
DEVICE=cuda
COMPUTE_TYPE=float16
HUGGINGFACE_TOKEN=your_hf_token_here   # required for pyannote diarization

# ── Ollama (local LLM — OFFLINE EXTRACTION PIPELINE ONLY) ────────────────────
# pipeline/extractor.py and initiative_extractor.py talk to Ollama directly
# with format="json". These do NOT control which model answers /ask.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── LLM (serving path: /ask generation + query routing) ──────────────────────
# Switching provider or model is env + API restart. No code change.
#   ollama     LLM_MODEL=qwen2.5:14b        (no key; the default)
#   gemini     LLM_MODEL=gemini-3.7-flash   escalate: gemini-3.5-flash / -pro
#   openai     LLM_MODEL=gpt-4o-mini
#   anthropic  LLM_MODEL=claude-sonnet-5
#   deepseek   LLM_MODEL=deepseek-chat
LLM_PROVIDER=ollama
# LLM_MODEL=          # defaults to OLLAMA_MODEL
# LLM_API_KEY=        # required for every provider except ollama
# LLM_BASE_URL=       # blank = the provider's own endpoint

# Generation knobs. Raise LLM_MAX_TOKENS on reasoning models (Gemini 2.5/3.x,
# o-series): their thinking tokens come out of this same budget, so a cap
# tuned for qwen2.5:14b can be spent before the first answer token.
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=1024
# LLM_REASONING_EFFORT=      # gemini: none | low | medium | high

# Timeouts. Two profiles: generation is patient, the query-router classifier
# fails fast and falls back to route="hybrid".
# LLM_CONNECT_TIMEOUT=5
# LLM_READ_TIMEOUT=120
# LLM_ROUTER_CONNECT_TIMEOUT=2
# LLM_ROUTER_READ_TIMEOUT=5
# LLM_ROUTER_MAX_TOKENS=16
# LLM_ROUTER_REASONING_EFFORT=none

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=neo_v2_chunks

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8

# ── Quality Gate ─────────────────────────────────────────────────────────────
MIN_WORD_COUNT=500
MIN_QUALITY_SCORE=0.6

# ── API / UI ports ────────────────────────────────────────────────────────────
API_PORT=8000
UI_PORT=8501

# Browser origins allowed to call the API cross-origin. Comma-separated, no
# trailing slash. Leave unset for local dev (defaults to localhost:3000/3001 +
# 127.0.0.1:3000). Set on deploy only if a browser hits the API on a hostname
# other than the one serving the frontend — the Next.js/Caddy proxy makes
# normal traffic same-origin, so CORS is not on the hot path.
#   NEO_CORS_ORIGINS=https://neo.example.com,https://staging.neo.example.com
# NEO_CORS_ORIGINS=

# ── Observability ─────────────────────────────────────────────────────────────
# Set to "off" to disable per-query JSONL log writes in observability/query_log.py
NEO_QUERY_LOG=on
# Optional override for where the log file lives (defaults to data/query_log.jsonl)
# NEO_QUERY_LOG_PATH=

PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# ── Next.js dev server (frontend/) ────────────────────────────────────────────
# The Next.js rewrite in next.config.mjs proxies /api/* to this host. Set this
# only on the SERVER side (don't expose as NEXT_PUBLIC_*). Defaults to localhost.
NEO_API_TARGET=http://localhost:8000
