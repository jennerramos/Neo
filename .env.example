# This is the WORKSTATION env: pipeline + local dev. The VPS serving stack has
# its own, much smaller file — see deploy/.env.deploy.example and deploy/README.md.
#
# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/neo_v2
SQL_ECHO=false

# ── YouTube / Google ──────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Browser for yt-dlp cookie extraction (firefox | chrome | edge | leave blank to disable)
YT_DLP_COOKIES_BROWSER=firefox

# Webshare residential rotating proxy URL (HTTP).
# Username can include or omit a numeric suffix (`-1`, `-2`...); the captioner
# strips it and adds `-rotate` so each request lands on a fresh residential IP.
# Leave blank to fetch captions direct from your local IP.
PROXY_LIST=http://username:password@p.webshare.io:80/

# ── WhisperX / ASR ───────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3
DEVICE=cuda
COMPUTE_TYPE=float16
HUGGINGFACE_TOKEN=your_hf_token_here   # required for pyannote diarization

# ── Ollama (local LLM — the fallback both neutral namespaces default to) ─────
# Set these two alone and every path (serving + extraction) stays fully local.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── LLM (serving path: /ask generation + query routing) ──────────────────────
# Switching provider or model is env + API restart. No code change.
#   ollama     LLM_MODEL=qwen2.5:14b        (no key; the default)
#   gemini     LLM_MODEL=gemini-3.5-flash   9/9 on the eval set; benchmarked
#                                           over 3.6 (misroutes rag->hybrid)
#                                           and 3.7 (503s, capacity-starved)
#   openai     LLM_MODEL=gpt-4o-mini
#   anthropic  LLM_MODEL=claude-sonnet-5
#   deepseek   LLM_MODEL=deepseek-chat
LLM_PROVIDER=ollama
# LLM_MODEL=          # defaults to OLLAMA_MODEL
# LLM_API_KEY=        # required for every provider except ollama
# LLM_BASE_URL=       # blank = the provider's own endpoint

# Generation knobs. Raise LLM_MAX_TOKENS on reasoning models (Gemini 2.5/3.x,
# o-series): their thinking tokens come out of this same budget, so a cap
# tuned for qwen2.5:14b can be spent before the first answer token.
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=1024        # 8192 on reasoning models — see LLM_REASONING_EFFORT
# LLM_REASONING_EFFORT=none  # gemini: none | low | medium | high.
# On Gemini 2.5/3.x, thinking tokens are spent from LLM_MAX_TOKENS BEFORE the
# first visible token — measured 82 of 2048 reaching the answer at default
# effort, truncating answers mid-sentence. "none" gave the longest answers,
# the lowest cost and the lowest latency, and took the eval from 8/9 to 9/9.

# Timeouts. Two profiles: generation is patient, the query-router classifier
# fails fast and falls back to route="hybrid".
#
# Mind that fallback when tightening the router budget. Measured 2026-08-16:
# gemini answers the one-word classification in 4.0-5.2s, so the old 5s read
# budget timed out on roughly half of calls and silently routed everything to
# hybrid — off-topic questions were answered instead of refused, and specific
# lookups never reached the SQL route. Defaults are now 5s/15s. Only lower
# them if you are serving from a local Ollama, which answers sub-second.
# LLM_CONNECT_TIMEOUT=5
# LLM_READ_TIMEOUT=120
# LLM_ROUTER_CONNECT_TIMEOUT=5
# LLM_ROUTER_READ_TIMEOUT=15
# LLM_ROUTER_MAX_TOKENS=16
# LLM_ROUTER_REASONING_EFFORT=none

# ── PIPELINE_LLM (offline extraction: extractor + initiative_extractor) ──────
# A separate namespace that does NOT inherit from LLM_* above. Unset, it falls
# back to OLLAMA_HOST/OLLAMA_MODEL — so pointing /ask at a paid provider leaves
# whole-corpus extraction on the local GPU. That asymmetry is deliberate:
# /ask is one call per question, extraction is N candidate windows x 4
# extraction types per meeting across every meeting you have.
#
# Measured on qwen2.5:14b, 2 HCC meetings (2026-08-14):
#   extractor.py            ~17 calls/meeting  ~22.8K tokens/meeting
#   initiative_extractor.py  ~7 calls/meeting  ~11.5K tokens/meeting
# Price a cloud provider against ~34K tokens/meeting before switching.
#
# anthropic is NOT usable here — no JSON mode; the provider raises rather than
# silently returning prose. ollama | gemini | openai | deepseek all work.
# PIPELINE_LLM_PROVIDER=ollama   # default
# PIPELINE_LLM_MODEL=            # defaults to OLLAMA_MODEL
# PIPELINE_LLM_API_KEY=          # required for every provider except ollama
# PIPELINE_LLM_BASE_URL=         # blank = the provider's own endpoint

# Extraction runs at temperature 0 — structured JSON, no sampling wanted.
# PIPELINE_LLM_TEMPERATURE=0
# A truncated answer on /ask is a short sentence; a truncated JSON array here
# fails to parse, yields zero rows, and reads downstream as "this meeting had
# no votes". Both extractors print a loud TRUNCATED warning when this cap is
# hit — raise it and re-run with --reextract if you ever see one.
#
# Every item now returns an evidence array with a verbatim quote per supported
# field, which roughly doubles output tokens: measured 63.7K -> 90.7K total for
# two meetings when provenance landed. 2048 is far too low for that; 16384 ran
# two meetings with no truncation. Budget ~45K tokens/meeting for extractor.py.
# PIPELINE_LLM_MAX_TOKENS=16384
# PIPELINE_LLM_REASONING_EFFORT=none

# Batch fan-out meets rate limits a single /ask never does, hence more retries.
# PIPELINE_LLM_CONNECT_TIMEOUT=5
# PIPELINE_LLM_READ_TIMEOUT=150
# PIPELINE_LLM_MAX_RETRIES=5

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=neo_v2_chunks

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8

# ── Quality Gate ─────────────────────────────────────────────────────────────
MIN_WORD_COUNT=500
MIN_QUALITY_SCORE=0.6

# ── API / UI ports ────────────────────────────────────────────────────────────
API_PORT=8000
UI_PORT=8501

# Browser origins allowed to call the API cross-origin. Comma-separated, no
# trailing slash. Leave unset for local dev (defaults to localhost:3000/3001 +
# 127.0.0.1:3000). Set on deploy only if a browser hits the API on a hostname
# other than the one serving the frontend — the Next.js/Caddy proxy makes
# normal traffic same-origin, so CORS is not on the hot path.
#   NEO_CORS_ORIGINS=https://neo.example.com,https://staging.neo.example.com
# NEO_CORS_ORIGINS=

# ── Observability ─────────────────────────────────────────────────────────────
# Set to "off" to disable per-query JSONL log writes in observability/query_log.py
NEO_QUERY_LOG=on
# Optional override for where the log file lives (defaults to data/query_log.jsonl)
# NEO_QUERY_LOG_PATH=

PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# ── Next.js dev server (frontend/) ────────────────────────────────────────────
# The Next.js rewrite in next.config.mjs proxies /api/* to this host. Set this
# only on the SERVER side (don't expose as NEXT_PUBLIC_*). Defaults to localhost.
NEO_API_TARGET=http://localhost:8000
