# Build context for the backend image (P1-1). The frontend has its own context
# and its own .dockerignore under frontend/.

.git
.gitignore
.github

# The frontend is built from ./frontend as a separate context.
frontend/

# Secrets — the container gets its env from deploy/.env.deploy at run time.
.env
.env.local
deploy/.env.deploy

# Workstation-only data. None of this belongs in a serving image, and data/
# alone can be gigabytes of transcripts.
data/
backups/
logs/
graphify-out/
docs/
specs/
ui/
flows/

# Python build/venv noise
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Test + eval assets are not needed to serve
tests/
eval/
test_captions.py

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
