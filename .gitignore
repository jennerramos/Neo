# ── Secrets ───────────────────────────────────────────────────────────────────
# .env contains DB credentials, API keys, proxy passwords, HF token.
# .env.example IS committed as a template.
.env
.env.local
**/.env
**/.env.local
!.env.example
# VPS deployment secrets (DB password, LLM key, basic-auth hash). The pattern
# above doesn't catch it — the suffix comes after ".env". The .example IS
# committed as a template.
deploy/.env.deploy

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Node / Next.js (frontend/) ────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo/

# ── Pipeline data (regenerable from upstream; may contain auth cookies) ───────
# data/yt_cookies.txt holds an authenticated YouTube session
# data/audio/, raw/, processed/ are large and can be re-derived
# data/query_log.jsonl is the per-query trace log
data/

# ── Knowledge graph (regenerable: `graphify ./api ./rag ./pipeline`) ─────────
graphify-out/

# graphify writes a machine-specific Python interpreter path here on first run.
# Regenerated automatically; never the same across machines, so we don't track it.
.graphify_python

# ── Claude Code (AI assistant config — kept local to each contributor) ────────
# .claude/settings.json:        shared hooks/policy (re-add if you onboard collaborators)
# .claude/settings.local.json:  personal permission grants
# Easier to keep the whole directory local for a solo project.
.claude/
**/*.local.json

# ── Alembic ───────────────────────────────────────────────────────────────────
alembic/versions/__pycache__/

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# local DB snapshots (restore points, not source)
backups/
