# ── Secrets ───────────────────────────────────────────────────────────────────
# .env contains DB credentials, API keys, proxy passwords, HF token.
# .env.example IS committed as a template.
.env
.env.local
**/.env
**/.env.local
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
